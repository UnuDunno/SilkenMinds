  m_Script: {fileID: 11500000, guid: 5ce4cc4c9b8c7bc46a073f480202eaff, type: 3}
  m_Name: LocomocaoNaTeia
  m_EditorClassIdentifier: Assembly-CSharp::ChoiceEvent
  eventTitle: "Locomo\xE7\xE3o na Teia"
  eventDescription: "Como as aranhas conseguem caminhar pelas pr\xF3prias teias pegajosas
    sem ficarem presas?"
  choice1: "Elas possuem pelos especiais e garras microsc\xF3picas nas pontas das
    patas que reduzem a \xE1rea de contato, al\xE9m de caminharem apenas pelos fios
    \"radiais\" da teia, que n\xE3o levam cola."
  outcome1: 0
  amount1: 30
  outcome1Title: Resposta Correta
  outcome1Text: 
  choice2: "Elas secretam um \xF3leo lubrificante natural por todo o corpo que dissolve
    instantaneamente a cola da teia por onde passam."
  outcome2: 3
  amount2: 0
  outecome2Title: Incorreto
  outcome2Text: "Respota Correta: Elas possuem pelos especiais e garras microsc\xF3picas
    nas pontas das patas que reduzem a \xE1rea de contato, al\xE9m de caminharem
    apenas pelos fios \"radiais\" da teia, que n\xE3o levam cola."
