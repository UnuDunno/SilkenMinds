  m_Script: {fileID: 11500000, guid: a8b0509b52fa57045bd73223092f6d1b, type: 3}
  m_Name: SobreOsFios
  m_EditorClassIdentifier: Assembly-CSharp::CuriosityEvent
  eventTitle: Sobre os fios
  eventDescription: "A teia de aranha \xE9 um dos materiais mais fortes da natureza.
    Proporcionalmente, um fio de seda de aranha \xE9 cinco vezes mais forte que um
    fio de a\xE7o da mesma espessura e pode se esticar at\xE9 quatro vezes seu comprimento
    sem quebrar. Al\xE9m disso, as aranhas n\xE3o t\xEAm sangue vermelho como o nosso;
    elas possuem hemolinfa, um fluido que fica azulado quando entra em contato com
    o oxig\xEAnio por conter cobre em vez de ferro."
  outcome: 0
  outcomeAmount: 50
